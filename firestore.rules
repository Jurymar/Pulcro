rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Clientes
    match /clientes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Lavanderos
    match /lavanderos/{userId} {
      allow read: if request.auth != null; 
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Pedidos
    match /pedidos/{pedidoId} {
      // Lectura:
      allow read: if request.auth != null && (
        // Cliente puede ver solo sus pedidos
        resource.data.clienteId == request.auth.uid ||
        // Lavandero puede ver todos los pedidos pendientes
        resource.data.status == "pending" ||
        // Lavandero puede ver los pedidos que ya aceptó
        resource.data.lavanderoId == request.auth.uid
      );

      // Creación: cualquier autenticado puede crear (cliente)
      allow create: if request.auth != null;

      // Actualización:
      allow update: if request.auth != null && (
        // Cliente puede modificar/cancelar su propio pedido si está pendiente
        (resource.data.clienteId == request.auth.uid && resource.data.status == "pending") ||
        // Lavandero puede actualizar pedido que ya tomó
        (resource.data.lavanderoId == request.auth.uid) ||
        // Lavandero puede tomar un pedido pendiente (asignárselo y pasarlo a in-progress)
        (resource.data.status == "pending" &&
         request.resource.data.lavanderoId == request.auth.uid &&
         request.resource.data.status == "in-progress")
      );

      // Eliminación: cliente puede borrar su propio pedido
      allow delete: if request.auth != null && resource.data.clienteId == request.auth.uid;
    }

    // Denegar lo no definido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
